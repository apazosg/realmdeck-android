+    private static Callback<String> snapshotDebugCallback() {
+        ArrayList<Callback<String>> callbacks;
+        synchronized (debugCallbacks) {
+            callbacks = new ArrayList<>(debugCallbacks);
+        }
+        return (line) -> {
+            if (!callbacks.isEmpty()) {
+                for (Callback<String> callback : callbacks) {
+                    try { callback.call(line); }
+                    catch (Exception e) {
+                        if (MainActivity.DEBUG_MODE) System.out.println("PROCESS-DIAGNOSTIC-CALLBACK-ERROR type="+e.getClass().getSimpleName());
