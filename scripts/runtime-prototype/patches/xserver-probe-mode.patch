+    private boolean finishProbe(int status) {
+        if (!probeMode || !ProbeRunStore.isValidRunId(probeRunId)) return false;
+        if (!probeRunFinished.compareAndSet(false, true)) return false;
+        if (probeTimeout != null) probeHandler.removeCallbacks(probeTimeout);
+        ProbeRunStore.appendHostLog(this, probeRunId, "XSERVER-END status="+status);
+        ProbeRunStore.finish(this, probeRunId, status);
+        return true;
+    }
+
+    private void requestProbeCleanup(int status) {
+        if (!probeMode || !ProbeRunStore.isValidRunId(probeRunId)) return;
+        if (!probeRunFinished.compareAndSet(false, true)) return;
+        if (probeTimeout != null) probeHandler.removeCallbacks(probeTimeout);
+        ProbeRunStore.appendHostLog(this, probeRunId,
+            status == 124 ? "PROBE-TIMEOUT timeoutMs=120000" : "PROBE-DESTROY status="+status);
+        stopProbeEnvironment();
+        ProcessHelper.awaitRuntimeProcessDiagnostics(5000L, (quiescent) -> {
+            ProbeRunStore.appendHostLog(this, probeRunId,
+                "PROBE-CLEANUP quiescent="+quiescent+" termination_unknown=true");
+            ProbeRunStore.blockNewRuns();
+            ProbeRunStore.finish(this, probeRunId, status, true, quiescent);
+            runOnUiThread(this::finish);
+        });
+    }
+
+    private void stopProbeEnvironment() {
+        if (probeMode && !probeEnvironmentStopped.compareAndSet(false, true)) return;
+        ProcessHelper.stopRuntimeProcessDiagnostics();
+        ProcessHelper.setRuntimeProcessDiagnosticsEnabled(false);
+        if (winHandler != null) winHandler.stop();
+        if (environment != null) environment.stopEnvironmentComponents();
+    }
