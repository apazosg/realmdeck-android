    "sha256": "70f1f9924d3649fed811634024eb5b40544485aa11b43d0f28959e95211fa3e2",
    "proton_wcp": "components/proton-11.0-90624-arm64ec.wcp",
    "dxvk_wcp": "components/dxvk-2.4.1-wow-aarch64-test.wcp"
  },
  "target": {
    "client_arch": "ARM64",
    "wine_arch": "aarch64-unix+aarch64-windows",
    "android_abi": "arm64-v8a",
    "gpu": "PowerVR BXM-8-256",
    "vulkan": "system",
    "turnip": false
  },
  "components": {
    "proton": {
      "version": "proton-11.0-90624-arm64ec",
      "prefix_pack": "prefixPack.txz",
      "bin_path": "bin",
      "lib_path": "lib"
    },
    "dxvk": {
      "version": "2.4.1-wow-aarch64-test",
      "windows_targets": ["system32/dxgi.dll", "system32/d3d11.dll"]
