  },
  "launcher_interface": {
    "runtime_dir": "<app-private-files>/runtimes/arm64/<version>",
    "prefix_dir": "<app-private-files>/prefixes/arm64/<version>",
    "client_pe": "<mapped-drive>/WowB-ARM64.exe",
    "argv": ["<runtime_dir>/proton-11.0-90624-arm64ec/bin/wine", "explorer", "/desktop=shell,<screen-size>", "<client-pe>", "-d3d11"],
    "cwd": "parent directory of client_pe",
    "env": {
