      "HOME": "<imagefs>/home/xuser",
      "PATH": "<imagefs>/usr/bin:<runtime_dir>/proton-11.0-90624-arm64ec/bin",
      "LD_LIBRARY_PATH": "<imagefs>/usr/lib:/system/lib64:<runtime_dir>/proton-11.0-90624-arm64ec/lib",
      "WINEESYNC": "0",
      "DISPLAY": ":0",
      "XDG_DATA_DIRS": "<imagefs>/usr/share",
      "PREFIX": "<imagefs>/usr",
      "renderer": "system Vulkan only; no Turnip/Adrenotools or VK_ICD_FILENAMES",
      "dll_search": "native ARM64 system32 only; no x86_64 override",
      "android_glue": "ANDROID_SYSVSHM_SERVER plus app-provided LD_PRELOAD glue"
    },
    "logs": ["runtime-provision.log", "wine-stdout.log", "wine-stderr.log", "runtime-manifest.json"]
  },
  "gates": [
    "verify outer ZIP hash and reject traversal",
    "stream-extract both WCP tarballs with traversal/special-file rejection",
    "audit every extracted ELF and PE header without execution",
    "audit prefixPack.txz member paths and architecture-compatible root",
    "run only on Android arm64 hardware; x86_64 emulator is not evidence"
  ]
}
