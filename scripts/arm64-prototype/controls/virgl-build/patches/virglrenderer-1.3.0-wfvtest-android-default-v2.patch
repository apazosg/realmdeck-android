+#if defined(WFVTEST_ANDROID_DEFAULT) && defined(__ANDROID__)
+#ifdef ENABLE_GBM
+   const bool android_default = gles && !surfaceless && !gbm;
+#else
+   const bool android_default = false;
+#endif
+#else
+   const bool android_default = false;
+#endif
 #ifdef WFVTEST_DIAG
    wfvtest_diag_value("compile.gbm", WFVTEST_DIAG_COMPILED_GBM);
