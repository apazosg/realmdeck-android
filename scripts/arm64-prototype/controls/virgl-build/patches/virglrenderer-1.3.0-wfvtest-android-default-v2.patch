 #ifdef WFVTEST_DIAG
       wfvtest_diag_value("init.reject_missing_gbm_or_platform", 1);
 #endif
@@ -385,8 +397,13 @@
 #endif
 
+#if defined(WFVTEST_ANDROID_DEFAULT) && defined(__ANDROID__)
+   if (android_default) {
+      egl->egl_display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+   } else
+#endif
 #ifdef ENABLE_GBM_ALLOCATION
    if (virgl_egl_get_display(egl)) {
      /* Make -Wdangling-else happy. */
    } else /* Fallback to surfaceless. */
 #endif
    if (has_egl_base) {
@@ -492,0 +509,21 @@
+#if defined(WFVTEST_ANDROID_DEFAULT) && defined(__ANDROID__)
