@@ -529,4 +562,24 @@
  fail:
+#if defined(WFVTEST_ANDROID_DEFAULT) && defined(__ANDROID__)
+   if (android_default) {
+      EGLBoolean cleanup_result;
+      if (egl->signaled_fence != EGL_NO_SYNC_KHR) {
+         cleanup_result = eglDestroySyncKHR(egl->egl_display, egl->signaled_fence);
+         virgl_error("WFVTEST_ANDROID_DEFAULT cleanup.sync result=%d\n", cleanup_result ? 1 : 0);
+      }
+      if (egl->egl_ctx != EGL_NO_CONTEXT) {
+         cleanup_result = eglMakeCurrent(egl->egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE,
