+         virgl_error("WFVTEST_ANDROID_DEFAULT cleanup.make_current result=%d\n", cleanup_result ? 1 : 0);
+         cleanup_result = eglDestroyContext(egl->egl_display, egl->egl_ctx);
+         virgl_error("WFVTEST_ANDROID_DEFAULT cleanup.context result=%d\n", cleanup_result ? 1 : 0);
+      }
+      if (egl->egl_display != EGL_NO_DISPLAY) {
+         cleanup_result = eglTerminate(egl->egl_display);
+         virgl_error("WFVTEST_ANDROID_DEFAULT cleanup.display result=%d\n", cleanup_result ? 1 : 0);
+      }
+   }
+#endif
    free(egl);
    return NULL;
