+   *max_dual_source_render_targets = 0;
+   *max_render_targets = 0;
+   *max_samples = 0;
+   *max_tbo_size = 0;
+   *max_uniform_blocks = 0;
+   *max_viewports = 0;
+   *max_texture_gather_components = 0;
