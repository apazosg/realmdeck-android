+   WFVTEST_CAP1(prim_mask, primitive_mask);
+   WFVTEST_CAP1(max_texture_array_layers, max_texture_array_layers);
+   WFVTEST_CAP1(max_streamout_buffers, max_streamout_buffers);
+   WFVTEST_CAP1(max_dual_source_render_targets, max_dual_source_render_targets);
