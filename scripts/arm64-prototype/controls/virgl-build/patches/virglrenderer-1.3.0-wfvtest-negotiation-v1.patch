+{
+   uint32_t glsl_level, bset, rawbitmask, primitive_mask;
+   uint32_t max_texture_array_layers, max_streamout_buffers;
+   uint32_t max_dual_source_render_targets, max_render_targets, max_samples;
+   uint32_t max_tbo_size, max_uniform_blocks, max_viewports;
