+static bool
+wfvtest_negotiation_begin(void)
+{
+   if (wfvtest_negotiation_rows < WFVTEST_NEGOTIATION_LIMIT) {
+      wfvtest_negotiation_rows++;
+      return true;
+   }
+
+   if (!wfvtest_negotiation_truncated) {
+      fprintf(stderr, "WFVTEST_NEGOTIATION {\"schema\":1,\"event\":\"trace_truncated\"}\n");
+      wfvtest_negotiation_truncated = true;
+   }
+   return false;
+}
+
+static bool
+wfvtest_negotiation_u32(const void *data, uint32_t bytes, size_t offset,
+                        uint32_t *value)
+{
+   if (!data || offset > bytes || bytes - offset < sizeof(*value))
+      return false;
+   memcpy(value, (const char *)data + offset, sizeof(*value));
+   return true;
+}
