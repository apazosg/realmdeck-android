+      &rawbitmask, &primitive_mask, &max_texture_array_layers,
+      &max_streamout_buffers, &max_dual_source_render_targets,
+      &max_render_targets, &max_samples, &max_tbo_size, &max_uniform_blocks,
+      &max_viewports, &max_texture_gather_components, &capability_bits,
+      &has_capability_bits);
+   if (has_capability_bits)
+      snprintf(capability_bits_text, sizeof(capability_bits_text), "%u", capability_bits);
+   fprintf(stderr,
+           "WFVTEST_NEGOTIATION {\"schema\":1,\"event\":\"cap_reply\",\"sequence\":%u,\"id\":%u,\"version\":%u,\"bytes\":%u,\"valid\":%u,\"glsl_level\":%u,\"bset\":%u,\"rawbitmask\":%u,\"primitiveMask\":%u,\"max_texture_array_layers\":%u,\"max_streamout_buffers\":%u,\"max_dual_source_render_targets\":%u,\"max_render_targets\":%u,\"max_samples\":%u,\"max_tbo_size\":%u,\"max_uniform_blocks\":%u,\"max_viewports\":%u,\"max_texture_gather_components\":%u,\"capability_bits\":%s}\n",
+           ++wfvtest_negotiation_sequence, id, version, bytes, valid ? 1u : 0u,
+           glsl_level, bset, rawbitmask, primitive_mask,
+           max_texture_array_layers, max_streamout_buffers,
+           max_dual_source_render_targets, max_render_targets, max_samples,
+           max_tbo_size, max_uniform_blocks, max_viewports,
+           max_texture_gather_components, capability_bits_text);
+}
+
+void
+wfvtest_negotiation_command(uint32_t length, uint32_t id)
